# ==========================================
# MoneyManagement - Environment Configuration Template
# Copy this file to .env.dev, .env.docker, or .env.prod
# ==========================================

# Active Spring Profile (development | test | docker | prod)
SPRING_PROFILES_ACTIVE=development

# MySQL Database Configuration
DB_HOST=localhost
DB_PORT=3306
DB_NAME=MoneyManagement
DB_USERNAME=root
DB_PASSWORD=your_database_password

# JPA / Hibernate Settings
JPA_DDL_AUTO=update
JPA_SHOW_SQL=true

# Server Configuration
SERVER_PORT=8080

# Brevo Mail / SMTP Configuration
MAIL_HOST=smtp-relay.brevo.com
MAIL_PORT=587
BREVO_LOGIN=your_brevo_smtp_login
BREVO_PASSWORD=your_brevo_smtp_master_key
BREVO_MAIL=noreply@yourdomain.com
MAIL_SMTP_AUTH=true
MAIL_SMTP_STARTTLS_ENABLE=true

# Application URLs
FRONTEND_URL=http://localhost:5173
MONEY_MANAGER_BACKEND_URL=http://localhost:8080
